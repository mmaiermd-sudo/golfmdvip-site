  <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.nav').classList.toggle('open')">☰</button>
  <nav class="nav">{nav}</nav>
</div></header>
<main>
{body}
</main>
<footer class="site-footer"><div class="wrap">
  <div class="cols">
    <div><h4>Golden Helmets &amp; Green Jackets</h4>
      <p class="tagline">Same Passion. Different Fairways.™</p>
      <p>Football. Golf. Medicine. Longevity. {host_line}</p></div>
    <div><h4>Explore</h4><ul>{"".join(f'<li><a href="{h}">{t}</a></li>' for h,t in NAV)}</ul></div>
