def listen_buttons(cls="btn-ghost"):
    return (f'<div class="btns listen"><a class="btn {cls}" href="{APPLE_PODCASTS_URL}" target="_blank" rel="noopener">🎧 Listen on Apple Podcasts</a>'
            f'<a class="btn {cls}" href="{SPOTIFY_URL}" target="_blank" rel="noopener">🎧 Listen on Spotify</a></div>')
def build_episodes():
    toc="".join(f'<a href="#ep{n}">Ep. {n}</a>' for i,n,g,b,t in EPISODES)+'<a href="#bonus">Bonus videos</a>'
    eps=""
    for i,n,g,b,t in EPISODES:
        x=m(i)
        eps+=f'''<article class="episode" id="ep{n}">
  <div>{lite(i,x["title"],x["duration"])}</div>
  <div><span class="num">Episode {n} · {date(x["upload_date"])} · {dur(x["duration"])}</span>
    <h3>{esc(EP_TITLE.get(n) or x["title"].split(": ",1)[-1])}</h3>
    <p><strong>{"Featuring" if n in EP_NO_GUEST else ("Guests" if "&" in g else "Guest")}:</strong> {esc(g)}</p>
    {guest_links(EP_GUESTS.get(n,[]))}
    <p>{esc(b)}</p>
    {EP_EXTRA.get(n,"")}
    <div class="meta">{"".join(f'<span class="tag">{esc(z)}</span>' for z in t)}</div>
    <a class="btn btn-green" href="{watch(i)}" target="_blank" rel="noopener">{ICON["yt"]} Watch on YouTube</a>
  </div></article>'''
    groups={}
    for i,gname in BONUS:
        if avail(i): groups.setdefault(gname,[]).append(i)
    bonus=""
    for gname,ids in groups.items():
        ids.sort(key=lambda i:m(i)["upload_date"],reverse=True)
        cards="".join(f'''<article class="card"><a class="thumb" href="{watch(i)}" target="_blank" rel="noopener"><img loading="lazy" src="{thumb(i)}" alt="{esc(m(i)["title"])}"></a>
<div class="body"><span class="eyebrow">{date(m(i)["upload_date"])} · {dur(m(i)["duration"])}</span><h3><a href="{watch(i)}" target="_blank" rel="noopener">{esc(m(i)["title"])}</a></h3><p>{esc(BONUS_BLURB.get(i,""))}</p><a class="more" href="{watch(i)}" target="_blank" rel="noopener">Watch on YouTube →</a></div></article>''' for i in ids)
        bonus+=f'<h3 class="subgroup">{esc(gname)}</h3><div class="grid">{cards}</div>'
    body=f'''
<section class="page-hero"><div class="wrap"><span class="eyebrow">Full episodes</span><h1>Episodes</h1>
<p>Every full episode of Golden Helmets &amp; Green Jackets, newest first. Tap a player to watch right here, or open it on YouTube.</p>
<div class="toc">{toc}</div>{listen_buttons()}</div></section>
<section><div class="wrap">{eps}</div></section>
<section class="alt" id="bonus"><div class="wrap"><span class="eyebrow">More from the channel</span><h2>Bonus videos</h2><div class="rule"></div>{bonus}</div></section>
<section class="follow"><div class="wrap"><h2>Never miss an episode</h2>{social_buttons()}{listen_buttons()}</div></section>'''
    return page("episodes.html","Episodes | Golden Helmets & Green Jackets Podcast","Every full episode of the Golden Helmets & Green Jackets Podcast.",body)

# ---------------- SHORTS ----------------
def short_tile(i,badge=None):
    x=m(i)
    b=f'<span class="badge">{esc(badge)}</span>' if badge else ""
    return f'''<a class="short" href="{short_url(i)}" target="_blank" rel="noopener"><div class="t"><img loading="lazy" src="{thumb(i)}" alt="{esc(x["title"])}">{b}<span class="dur">{dur(x["duration"])}</span></div><h4>{esc(x["title"])}</h4><small>{date(x["upload_date"])}</small></a>'''
def build_shorts():
    out=""; total=0
    for gname,gdesc,subs in SHORT_GROUPS:
        inner=""
        for sname,ids in subs:
            ids=[i for i in ids if avail(i)]
            if not ids: continue
            total+=len(ids)
            if sname: inner+=f'<h3 class="subgroup">{esc(sname)}</h3>'+guest_links(SHORT_GUESTS.get(sname,[]))
            inner+=f'<div class="shorts">{"".join(short_tile(i) for i in ids)}</div>'
        slug=gname.lower().split()[0].strip("'")
        out+=f'<div class="group" id="{slug}"><h2>{esc(gname)}</h2><div class="rule"></div><p>{esc(gdesc)}</p>{inner}</div>'
    body=f'''
<section class="page-hero"><div class="wrap"><span class="eyebrow">{total} Shorts</span><h1>Shorts</h1>
<p>Bite-size guest stories, sports-medicine explainers and GOLFDOC’s picks. Each one opens on YouTube Shorts.</p>
<div class="toc"><a href="#guest">Guest stories</a><a href="#sports">Sports medicine</a><a href="#golfdoc">Picks &amp; takes</a></div></div></section>
<section><div class="wrap">{out}</div></section>
<section class="follow"><div class="wrap"><h2>New Shorts every week</h2>{social_buttons()}</div></section>'''
    return page("shorts.html","Shorts | Golden Helmets & Green Jackets Podcast","Guest stories, sports medicine explainers and GOLFDOC's picks.",body), total

# ---------------- TEAM ----------------
TEAM_HOST = '''Michael Maier, M.D. — “GolfDoc” to the show — is an orthopedic surgeon and has been an Assistant Professor of Orthopedic Surgery at Baylor College of Medicine since January 2018. A cum laude graduate of the University of Notre Dame (Class of 1994), he earned his M.D. at UT Southwestern Medical School and trained in general and orthopaedic surgery at Duke University Medical Center. Board certified by the American Board of Orthopaedic Surgery, he cares for athletes and active patients across sports medicine, joint reconstruction, trauma and golf-specific injuries, and holds Titleist Performance Institute Medical Level 3 certification. On Golden Helmets &amp; Green Jackets he brings the operating-room view to college football, golf and the Notre Dame stories he has loved since his days under the Golden Dome. Go Irish!'''
