def social_buttons(cls="btn-gold", ghost="btn-ghost"):
    b=[f'<a class="btn {cls}" href="{YT_SUB}" target="_blank" rel="noopener">{ICON["yt"]} Subscribe on YouTube</a>']
    if FACEBOOK_URL: b.append(f'<a class="btn {ghost}" href="{FACEBOOK_URL}" target="_blank" rel="noopener">{ICON["fb"]} GOLF MD VIP</a>')
    if IG_PODCAST_URL: b.append(f'<a class="btn {ghost}" href="{IG_PODCAST_URL}" target="_blank" rel="noopener">{ICON["ig"]} GoldenHelmets&amp;GreenJackets</a>')
    if IG_GOLFMDVIP_URL: b.append(f'<a class="btn {ghost}" href="{IG_GOLFMDVIP_URL}" target="_blank" rel="noopener">{ICON["ig"]} @GolfMDVIP</a>')
    if FOUR_HORSEMEN_FB_URL: b.append(f'<a class="btn {ghost}" href="{FOUR_HORSEMEN_FB_URL}" target="_blank" rel="noopener">{ICON["fb"]} Four Horsemen Plus</a>')
    b.append(f'<a class="btn {ghost}" href="{X_URL}" target="_blank" rel="noopener">{ICON["x"]} @GolfMDVIP</a>')
    b.append(f'<span class="btn {ghost} disabled" title="Coming soon">{ICON["tt"]} TikTok — coming soon</span>')
    return '<div class="btns">'+"".join(b)+'</div>'

def thumb(i):
    """Local thumbnail for a video. Existing img/thumbs/{id}.jpg is NEVER regenerated.
    Missing: 1) download YouTube's own hqdefault.jpg; 2) only if that fails, branded GH&GJ template; 3) _default.jpg."""
    import os,subprocess,urllib.request,json
    base=os.path.dirname(os.path.abspath(__file__)); p=f"img/thumbs/{i}.jpg"; full=os.path.join(base,p)
    if os.path.exists(full) and os.path.getsize(full)>0: return p
    try:
        data=urllib.request.urlopen(f"https://i.ytimg.com/vi/{i}/hqdefault.jpg",timeout=20).read()
        if len(data)>2000:
            open(full,"wb").write(data); return p
    except Exception: pass
    fr=f"/tmp/thumbframe_{i}.png"
    try:
        mp4=f"/workspace/yt/shorts_dl/{i}.mp4"
        if os.path.exists(mp4) and subprocess.run(["ffmpeg","-v","error","-y","-ss","4","-i",mp4,"-frames:v","1",fr]).returncode==0:
            t=i
            try: t=json.load(open(f"/workspace/yt/meta/{i}.info.json")).get("title",i)
            except Exception: pass
            if subprocess.run(["python3",os.path.join(base,"make_thumb.py"),fr,full,t,"Golden Helmets & Green Jackets"]).returncode==0: return p
    except Exception: pass
    return "img/thumbs/_default.jpg"

def lite(i, title, seconds=None):
    d = f'<span class="dur">{dur(seconds)}</span>' if seconds else ""
    return (f'<div class="video" data-yt="{i}" style="background-image:url({thumb(i)})" role="group" aria-label="{esc(title)}">'
            f'<button class="play" type="button" aria-label="Play: {esc(title)}"><span>{ICON["play"]}</span></button>{d}'
            f'<noscript><a href="{watch(i)}" target="_blank" rel="noopener">Watch on YouTube</a></noscript></div>')

