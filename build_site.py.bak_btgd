def link_row(items):
    """items: list of (icon_key or None, label, url) – url None = hidden."""
    a=[f'<a class="btn btn-outline btn-sm" href="{u}" target="_blank" rel="noopener">{ICON[k] if k else ""}{l}</a>' for k,l,u in items if u]
    return f'<div class="btns member-links">{"".join(a)}</div>' if a else ""
TEAM_LINKS = {
 "MI": [("ig","Life on the Cut Line",MATTY_IG_URL)],
 "TC": [("li","LinkedIn",GUEST["tevon"][4]),("x","@TevonConey",TEVON_X_URL),("ig","Instagram",TEVON_IG_URL),("fb","Facebook",TEVON_FB_URL),
        (None,"Tough Choices Foundation",TCF_URL),("ig","@toughchoices",TCF_IG_URL),("fb","Tough Choices on Facebook",TCF_FB_URL)],
 "BV": [("li","LinkedIn",GUEST["brandon"][4]),(None,"Patient Discharge Initiative (PDI)",PDI_URL),("ig","@uh_pdi",PDI_IG_URL)],
}
TEAM_PHOTOS = {"MM":"img/team/michael-maier-golfdoc.jpg","MI":"img/team/matthew-maier.jpg","TC":"img/team/tevon-coney.jpg","BV":"img/team/brandon-varon.jpg"}
TEAM_ANCHORS = {"MM":"golfdoc","MI":"matty-ice","TC":"tevon-coney","BV":"brandon-varon"}
def avatar(ini,name):
    ph=TEAM_PHOTOS.get(ini)
    return f'<div class="avatar photo"><img src="{ph}" alt="{esc(name)}" loading="lazy"></div>' if ph else f'<div class="avatar">{ini}</div>'
def build_team():
    host=f'''<article class="member host" id="golfdoc">{avatar("MM","Michael Maier, M.D. (GolfDoc)")}<div>
<h3>Michael Maier, M.D. <span style="color:var(--gold-dk)">“GolfDoc”</span></h3><div class="role">Host · Founder</div>
<p>{TEAM_HOST}</p>
<div class="facts"><span class="tag gold">Notre Dame ’94</span><span class="tag">Orthopedic surgeon</span><span class="tag">Baylor College of Medicine</span><span class="tag">Duke Orthopaedics</span><span class="tag">TPI Medical Level 3</span></div>
{link_row([("li","LinkedIn",MM_LINKEDIN_URL),(None,"My TPI Certified Expert profile",TPI_PROFILE_URL),(None,"Titleist Performance Institute",TPI_URL),("x","@MichaelMaierMD",MM_X_URL),("ig","Instagram",MM_IG_URL)])}
</div></article>'''
    others="".join(f'''<article class="member"{f' id="{TEAM_ANCHORS[ini]}"' if ini in TEAM_ANCHORS else ""}>{avatar(ini,name)}<div><h3>{name}</h3><div class="role">{role}</div>{"".join(f"<p>{p}</p>" for p in ps)}<div class="facts">{"".join(f'<span class="tag">{t}</span>' for t in tags)}</div>{link_row(TEAM_LINKS.get(ini,[]))}</div></article>''' for ini,name,role,ps,tags in TEAM)
    partners=[("Titleist Performance Institute","GolfDoc is a TPI Medical Level 3 Certified Expert. Find his profile or a TPI expert near you.",[("My TPI profile",TPI_PROFILE_URL),("mytpi.com",TPI_URL)]),
              ("Patient Discharge Initiative","University of Houston student organization serving underserved patients after discharge at LBJ Hospital — led in part by Brandon Varon.",[("UH PDI",PDI_URL),("Instagram @uh_pdi",PDI_IG_URL)]),
              ("Tough Choices Foundation","Tevon Coney’s nonprofit mentoring young people to reach their goals.",[("toughchoicesfoundation.com",TCF_URL),("Instagram",TCF_IG_URL),("Facebook",TCF_FB_URL)]),
              ("Notre Dame Orthopaedic Society","Founded in 1995 by Notre Dame alumni, NDOS hosts the annual Notre Dame Orthopaedic Symposium in South Bend: a weekend of teaching, reunion and Irish football for anyone in musculoskeletal care. Guests Chip Taunt and A.J. Mencias are part of the NDOS family.",[("ndorthosociety.org",NDOS_URL),("NDOS over the years","ndos.html")])]
    EP10_URL="https://youtu.be/sajx6Idwb_I"
    friends=[("Dr. Tom Parr","img/team/tom-parr.jpg","Dr. Thomas J. “Tom” Parr, M.D., F.A.C.S., is a 1967 West Point graduate and Army Ranger who commanded an armored cavalry troop in Germany and a mechanized infantry company in Vietnam, then became an orthopaedic surgeon and retired from the Army Medical Corps as a Colonel in 1987. He has practiced orthopaedics in Sugar Land for more than 30 years, now with Baylor St. Luke’s Medical Group, where he is GolfDoc’s partner, and has served on the board of the West Point Society of Greater Houston since 1989. Tom and his wife Joannie brought John Robb and Otto Leone into GolfDoc’s life. Episode 10 is dedicated to Tom, Joannie and Bill York.",[("LinkedIn","https://www.linkedin.com/in/thomas-parr-6795ba2a"),("Watch Episode 10",EP10_URL)]),
             ("Bill York","img/team/bill-york.jpg","William H. “Bill” York, West Point Class of 1981, is the founder of Tudor Lewis, a retained executive search firm, after senior staffing roles at Compaq and Bank of America. Bill is the connector who put the West Point episode together. Episode 10 is dedicated to him, along with Tom and Joannie Parr.",[("LinkedIn","https://www.linkedin.com/in/william-york-403122"),("Watch Episode 10",EP10_URL)])]
    fcards="".join(f'''<div class="cbox friend-card"><img class="friend-photo" src="{img}" alt="{esc(n)}" loading="lazy"><h3>{esc(n)}</h3><p>{esc(d)}</p><div class="btns">{"".join(f'<a class="btn btn-green btn-sm" href="{u}" target="_blank" rel="noopener">{esc(l)}</a>' for l,u in ls if u)}</div></div>''' for n,img,d,ls in friends)
    pcards=fcards+"".join(f'''<div class="cbox"><h3>{esc(n)}</h3><p>{esc(d)}</p><div class="btns">{"".join(f'<a class="btn btn-green btn-sm" href="{u}" target="_blank" rel="noopener">{esc(l)}</a>' for l,u in ls if u)}</div></div>''' for n,d,ls in partners)
    def _gl(g):
        k,name,desc,app,u,kind=g
        link=(f'<a class="glink" href="{u}" target="_blank" rel="noopener">{ICON["li"] if kind=="li" else ICON["link"]}<span>{"LinkedIn" if kind=="li" else "Bio"}</span></a>') if u else ""
        face=guest_face(k,"gl-face")
        return f'<li>{face}<div class="gl-text"><strong>{name}</strong><span class="gdesc">{desc}</span><span class="gapp">{app}</span></div>{link}</li>'
    glist="".join(_gl(g) for g in GUESTS)
    body=f'''
<section class="page-hero"><div class="wrap"><span class="eyebrow">The team</span><h1>Meet the crew</h1>
<p>The people behind Golden Helmets &amp; Green Jackets — on the mic and behind the scenes.</p></div></section>
<section><div class="wrap"><div class="team">{host}{others}</div>
<div class="physician-wrap"><span class="eyebrow">Our Athletes’ team physician</span>{physician_card(compact=True)}</div></div></section>
{upcoming_bios()}
<section id="links"><div class="wrap"><span class="eyebrow">Partners &amp; links</span><h2>Friends of the show</h2><div class="rule"></div><div class="contact-grid">{pcards}</div></div></section>
<section id="guests"><div class="wrap"><span class="eyebrow">Our guests</span><h2>Guests &amp; contributors</h2><div class="rule"></div>
<p class="lead">Everyone who has joined GolfDoc on the show. Tap the LinkedIn or bio link to learn more about their work.</p>
<ul class="guest-list">{glist}</ul>
<div class="btns"><a class="btn btn-green" href="episodes.html">Watch the episodes</a><a class="btn btn-outline" href="contact.html">Want to be a guest?</a></div></div></section>'''
    return page("team.html","Team | Golden Helmets & Green Jackets Podcast","Meet GolfDoc Michael Maier, M.D., co-hosts Tevon Coney and Matty Ice, and the production team.",body)

# ---------------- CONTACT ----------------
def build_contact():
    mt=lambda subj: f"mailto:{EMAIL}?subject="+subj.replace(" ","%20")
    body=f'''
<section class="page-hero"><div class="wrap"><span class="eyebrow">Get in touch</span><h1>Contact</h1>
<p>Guest ideas, sponsorships, partnerships or just a great Notre Dame story — we’d love to hear from you.</p>
<p style="margin-top:18px"><a class="email-big" href="mailto:{EMAIL}">{EMAIL}</a></p></div></section>
<section><div class="wrap"><div class="contact-grid">
  <div class="cbox"><h3>🎙️ Be a guest</h3><p>Former players, coaches, surgeons, golfers and anyone with a story where football, golf and medicine meet.</p><a class="btn btn-green" href="{mt("Guest inquiry - Golden Helmets & Green Jackets").replace("&","%26")}">{ICON["mail"]} Guest inquiry</a></div>
  <div class="cbox"><h3>🤝 Sponsor the show</h3><p>Reach college football fans, golfers and the sports-medicine community through episodes, Shorts and social.</p><a class="btn btn-green" href="{mt("Sponsorship inquiry - Golden Helmets & Green Jackets").replace("&","%26")}">{ICON["mail"]} Sponsor inquiry</a></div>
  <div class="cbox"><h3>📣 Say hello</h3><p>Questions, feedback or a topic you want GolfDoc to break down? Drop us a line.</p><a class="btn btn-green" href="mailto:{EMAIL}">{ICON["mail"]} Email us</a></div>
</div>
<p class="lead" style="margin-top:28px">Please don’t send personal medical questions — the show can’t give individual medical advice.</p>
</div></section>
<section class="follow"><div class="wrap"><h2>Follow along</h2>{social_buttons()}</div></section>'''
    return page("contact.html","Contact | Golden Helmets & Green Jackets Podcast","Guest and sponsor inquiries for the Golden Helmets & Green Jackets Podcast.",body)

from athletes import *  # GolfMDVIP "Our Athletes" pages (data + builders)
from ndos import NDOS_BUILDERS  # Notre Dame Orthopaedic Society hub + year pages

PICKS=[(8,"Week 8: GOLFDOC's LOCKS","Oct 24, 2026","L9eK_Xkh-gc","Cade vs. Brandon vs. GolfDoc pick board"),
(7,"Week 7 Picks","Oct 17, 2026",None,"Week 7 slate"),
(6,"Week 6 Picks","Oct 10, 2026",None,"Week 6 slate"),
(5,"GolfDoc Week 5 Slate","Oct 3, 2026","MWEiz4gKVLg","Week 5 slate"),
(4,"GOLFDOC's Week 4 LOCKS","Sep 26, 2026","1VMsHvE75oY","Week 4 lineup")]
def build_picks():
    cards=""
    for w,t,d,vid,alt in PICKS:
        img=f'<img src="img/picks/week{w}.jpg" alt="{esc(alt)}" loading="lazy" style="width:100%;border-radius:10px;display:block">'
        if vid: img=f'<a href="https://youtu.be/{vid}" target="_blank" rel="noopener">{img}</a>'
        link=f'<a class="btn" href="https://youtu.be/{vid}" target="_blank" rel="noopener">Watch the picks</a>' if vid else '<span style="opacity:.7">Episode link coming soon</span>'
        gal=''
        if w==8: gal='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin:.6em 0">'+''.join(f'<a href="img/picks/week8_gallery/w8_{i:02d}.jpg" target="_blank" rel="noopener"><img src="img/picks/week8_gallery/w8_{i:02d}.jpg" alt="Week 8 picks image {i}" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:6px;display:block"></a>' for i in range(1,13))+'</div>'
        if w==8: gal+='<p style="margin:.4em 0"><strong>Week 8 Shorts:</strong> <a href="https://www.youtube.com/shorts/syJFq-6xwSo" target="_blank" rel="noopener">Cruzen\'s Turkey Triple Play</a> · <a href="https://www.youtube.com/shorts/o8jpKl9sudE" target="_blank" rel="noopener">Brandon\'s &quot;Muscles from Brussels&quot;</a></p>'
        cards+=f'<article style="background:rgba(255,255,255,.04);padding:14px;border-radius:14px">{img}<h3 style="margin:.6em 0 .2em">{esc(t)}</h3><p style="margin:0 0 .6em;opacity:.8">Games of {esc(d)}</p>{gal}{link}</article>'
    body=f'''<section class="section"><div class="wrap"><h1>Weekly Picks</h1><p>Every week's GOLFDOC picks board. Tap a graphic to watch that week's picks episode. For entertainment only. 21+.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px;margin-top:20px">{cards}</div></div></section>'''
    return page("picks.html","Weekly Picks | Golden Helmets & Green Jackets Podcast","GOLFDOC's weekly college football picks, week by week.",body)

BTG_FORM="https://docs.google.com/forms/d/e/1FAIpQLSd-QhDD49vP2aA1UtMysN2aCWY7Ad66fyKtQSVDjEIBgjlD0g/viewform"
BTG_LB="https://docs.google.com/spreadsheets/d/e/2PACX-1vTlacNh2xMA55BtWshSJ6Sr8gBi-GLgNJ05ZfGfXXSuE8hRl1fq9CwF7u-bm6UUe6-0oVDguyccJDot/pubhtml?gid=226126485&amp;single=true"
def build_btg():
    body=f'''<section class="section"><div class="wrap">
<img src="img/btg/header.png" alt="Beat the GolfDoc" style="width:100%;border-radius:14px;border:2px solid rgba(201,151,0,.6);display:block">
<span class="eyebrow" style="display:block;margin-top:24px">Free weekly picks contest</span><h1>Beat the GolfDoc</h1>
<p>Think you can out-pick the GolfDoc? Each week, take GolfDoc's 5-game college football slate against the spread, then make your bonus calls on the <strong>Fairway Finder</strong>, <strong>GolfDoc Special</strong> and <strong>Golden Domer</strong> parlays, <strong>Cade's Turkey Triple</strong>, and the <strong>Matty Ice Lock</strong>. It's free to play, for bragging rights only.</p>
<p style="font-size:1.1rem"><strong>Winners will be considered for guest cameo appearances on future episodes with the GolfDoc, Cade, Matty Ice and Brandon.</strong></p>
<div class="btns" style="margin:22px 0 8px"><a class="btn btn-gold" style="font-size:1.25rem;padding:18px 34px" href="{BTG_FORM}" target="_blank" rel="noopener">Enter Your Picks</a><a class="btn btn-outline" href="picks.html">See GolfDoc's Weekly Picks</a></div>
<h2 style="margin-top:36px">How it works</h2>
<ol><li>Open the entry form and pick each of the 5 games against the spread.</li><li>Make your bonus calls: Fairway Finder, GolfDoc Special, Golden Domer, Cade's Turkey Triple and the Matty Ice Lock.</li><li>Submit before kickoff, then check the leaderboard to see if you beat the GolfDoc.</li></ol>
<h2 style="margin-top:36px">Leaderboard</h2>
<iframe src="{BTG_LB}&amp;widget=true&amp;headers=false" title="Beat the GolfDoc leaderboard" loading="lazy" style="width:100%;height:560px;border:1px solid rgba(0,0,0,.15);border-radius:12px;background:#fff"></iframe>
<p><a href="{BTG_LB}" target="_blank" rel="noopener">Leaderboard not loading? Open it in a new tab.</a></p>
<p style="font-size:.85rem;opacity:.75">Free to enter. No purchase, wager or payment of any kind. Bragging rights only. For entertainment purposes.</p>
</div></section>
'''
    return page("beat-the-golfdoc.html","Beat the GolfDoc | Golden Helmets & Green Jackets Podcast","Beat the GolfDoc: a free weekly college football picks contest. Bragging rights only.",body)

if __name__=="__main__":
    from PIL import Image
    Image.open(f"{OUT}/img/avatar.jpg").resize((192,192)).save(f"{OUT}/img/avatar_192.png")
    open(f"{OUT}/index.html","w").write(build_home())
    open(f"{OUT}/episodes.html","w").write(build_episodes())
    s,total=build_shorts(); open(f"{OUT}/shorts.html","w").write(s)
    open(f"{OUT}/picks.html","w").write(build_picks())
    open(f"{OUT}/beat-the-golfdoc.html","w").write(build_btg())
    open(f"{OUT}/team.html","w").write(build_team())
    open(f"{OUT}/contact.html","w").write(build_contact())
    open(f"{OUT}/athletes.html","w").write(build_athletes())
    for a in ATHLETES: open(f"{OUT}/{a['slug']}.html","w").write(build_athlete(a))
    for fn,fnc in NDOS_BUILDERS.items(): open(f"{OUT}/{fn}","w").write(fnc())
    print("episodes",len(EPISODES),"bonus",sum(avail(i) for i,_ in BONUS),"shorts",total)
