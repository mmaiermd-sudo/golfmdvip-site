def guest_face(k, cls="gface"):
    ph=GUEST_PHOTOS.get(k)
    return f'<img class="{cls}" src="{ph}" alt="" width="22" height="22" loading="lazy">' if ph else ""
def guest_links(keys, cls="guest-links"):
    """Small LinkedIn / bio pills for the guests that have a verified link."""
    a=[]
    for k in keys:
        _,name,_,_,u,kind=GUEST[k]
        if not u: continue
        icon=guest_face(k) or (ICON["li"] if kind=="li" else ICON["link"])
        label="LinkedIn" if kind=="li" else "Bio"
        a.append(f'<a class="glink" href="{u}" target="_blank" rel="noopener" title="{name} on {label}">{icon}<span>{name} · {label}</span></a>')
    return f'<div class="{cls}">{"".join(a)}</div>' if a else ""

# yt-dlp's upload_date is the UTC date; show the Central-time date (America/Chicago) from the upload timestamp
_CT = zoneinfo.ZoneInfo("America/Chicago")
def m(i):
    d=json.load(open(f"{META}/{i}.info.json"))
    if d.get("timestamp"): d["upload_date"]=datetime.datetime.fromtimestamp(d["timestamp"],_CT).strftime("%Y%m%d")
    return d
def esc(s): return html.escape(s or "", quote=True)
def date(d): return datetime.datetime.strptime(d, "%Y%m%d").strftime("%b %-d, %Y")
def dur(sec):
    sec=int(sec or 0); h,r=divmod(sec,3600); mi,s=divmod(r,60)
    return f"{h}:{mi:02d}:{s:02d}" if h else f"{mi}:{s:02d}"
def watch(i): return f"https://www.youtube.com/watch?v={i}"
def short_url(i): return f"https://www.youtube.com/shorts/{i}"

