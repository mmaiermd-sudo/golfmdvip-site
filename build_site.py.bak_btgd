  ["Otto earned his engineering degree at West Point and quarterbacked Army from 1987 to 1990 in Jim Young’s wishbone. On Halloween 1987 he started the year as sixth-string QB, came in against Temple, and his only pass went 64 yards to Mark Charette for a touchdown in a 17–7 Army win.",
   "He later earned his MBA at Notre Dame, spent 2009–2024 at Schindler Elevator, finishing as VP of the South Central region, and is now SVP, Multi-Family, at Repipe Specialists. His advice to West Point’s Class of 2029: “Be a great teammate, be a servant leader, take care of each other, and always put the mission first.”"],
  ["West Point ’91","Army QB","Notre Dame MBA"]),
]
def upcoming_episode():
    u=UPCOMING
    return f'''<article class="episode upcoming" id="{u["anchor"]}">
  <div><div class="soon-thumb"><img src="{u["thumb"]}" alt="{u["title"]}" loading="lazy"><span class="badge soon">Coming soon</span></div></div>
  <div><span class="num">{u["meta"]}</span>
    <h3>{u["title"]}</h3>
    <p><strong>Guests:</strong> John Robb &amp; Otto Leone (West Point Class of 1991)</p>
    {guest_links(u["guests"])}
    <p>{u["blurb"]}</p>
    <div class="meta">{"".join(f'<span class="tag">{z}</span>' for z in u["tags"])}</div>
    <span class="btn btn-outline" aria-disabled="true">Episode coming soon</span>
  </div></article>'''
def upcoming_bios():
    cards="".join(f'''<article class="member" id="{k}"><div class="avatar photo"><img src="{GUEST_PHOTOS[k]}" alt="{name}" loading="lazy"></div><div><h3>{name}</h3><div class="role">{role}</div>{"".join(f"<p>{p}</p>" for p in ps)}<div class="facts">{"".join(f'<span class="tag">{t}</span>' for t in tags)}<a class="tag gold" href="episodes.html#ep10">Watch Episode 10 →</a></div>{link_row([("li","LinkedIn",GUEST[k][4])])}</div></article>''' for k,name,role,ps,tags in UPCOMING_BIOS)
    return f'''<section class="alt" id="west-point-guests"><div class="wrap"><span class="eyebrow">New guests · Episode 10: West Point Football</span><h2>From West Point to the show</h2><div class="rule"></div><div class="team">{cards}</div></div></section>'''

