      <li><a href="{SPOTIFY_URL}" target="_blank" rel="noopener">Spotify</a></li>
      {f'<li><a href="{FACEBOOK_URL}" target="_blank" rel="noopener">Facebook · GOLF MD VIP</a></li>' if FACEBOOK_URL else ''}
      {f'<li><a href="{IG_PODCAST_URL}" target="_blank" rel="noopener">Instagram · GoldenHelmets&amp;GreenJackets</a></li>' if IG_PODCAST_URL else ''}
      {f'<li><a href="{IG_GOLFMDVIP_URL}" target="_blank" rel="noopener">Instagram · @GolfMDVIP</a></li>' if IG_GOLFMDVIP_URL else ''}
      {f'<li><a href="{FOUR_HORSEMEN_FB_URL}" target="_blank" rel="noopener">Facebook · Four Horsemen Plus</a></li>' if FOUR_HORSEMEN_FB_URL else ''}
      <li><a href="{X_URL}" target="_blank" rel="noopener">X · @GolfMDVIP</a></li>
      <li>TikTok · coming soon</li>
      <li><a href="{TPI_PROFILE_URL}" target="_blank" rel="noopener">GolfDoc on TPI</a></li>
      <li><a href="mailto:{EMAIL}">{EMAIL}</a></li></ul></div>
  </div>
  <div class="fine">© {datetime.date.today().year} Golden Helmets &amp; Green Jackets Podcast · GOLF MD VIP. Picks are for entertainment only; odds change. Sports-medicine content is educational and is not medical advice — see your own physician for diagnosis and treatment.</div>
</div></footer>
<script>
document.querySelectorAll('.video[data-yt]').forEach(function(v){{
  v.addEventListener('click',function(){{
    if(v.querySelector('iframe'))return;
    var f=document.createElement('iframe');
    f.src='https://www.youtube-nocookie.com/embed/'+v.dataset.yt+'?autoplay=1&rel=0';
